{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/app/caminho",
      "destination": "/index.html"
    },
    {
      "source": "/app/caminho/",
      "destination": "/index.html"
    },
    {
      "source": "/api/linkedin",
      "destination": "/api/linkedin"
    },
    {
      "source": "/api/linkedin/callback",
      "destination": "/api/linkedin/callback"
    },
    {
      "source": "/post/:id",
      "destination": "/api/public-post?id=:id"
    },
    {
      "source": "/api/public-post",
      "destination": "/api/public-post"
    },
    {
      "source": "/papos-app",
      "destination": "/papos-app/index.html"
    },
    {
      "source": "/papos-app/:path*",
      "destination": "/papos-app/index.html"
    },
    {
      "source": "/store/",
      "destination": "/store/index.html"
    },
    {
      "source": "/store",
      "destination": "/store/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/guia",
      "destination": "/guia/index.html"
    },
    {
      "source": "/guia/",
      "destination": "/guia/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/papos-app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/papos-app/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/caminho",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/caminho/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/app/caminho",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/app/caminho/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kosolola.com"
        }
      ],
      "destination": "/papos-app/",
      "permanent": false
    }
  ]
}
